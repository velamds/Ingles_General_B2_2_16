{"_data": [{"type": "metadata", "contents": [{"content": "A Brave New World", "type": "lesson_name"}, {"content": "How Connected Are You?", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Understand detailed descriptions of real or imaginary events and experiences in present, past or future and in spoken or written texts.", "type": "primary"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"type": "target_word", "contents": [{"content": "to forward", "type": "name"}, {"content": " to send on", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You don't need to forward this to me, I'll be going there anyway. ", "type": "example"}, {"content": "engenn10le16ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about cell phone use.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to interact ", "type": "name"}, {"content": "communicate and react with others", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'll be taking note of how you interact.", "type": "example"}, {"content": "engenn10le16ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "stationary", "type": "name"}, {"content": "not moving", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Stationary cameras, mounted on the wall, will be recording people talking, texting, tweeting, posting, or taking selfies. ", "type": "example"}, {"content": "engenn10le16ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to mount ", "type": "name"}, {"content": " attach to a wall", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Stationary cameras, mounted on the wall, will be recording people talking, texting, tweeting, posting, or taking selfies. ", "type": "example"}, {"content": "engenn10le16ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dull", "type": "name"}, {"content": "not interesting or exciting", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: If you knew how seriously dull people were today, you would get it immediately!", "type": "example"}, {"content": "engenn10le16ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "verbally", "type": "name"}, {"content": " express using oral communication", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: How long will those caught immersed in their phones remain there before they raise their heads and verbally connect?", "type": "example"}, {"content": "engenn10le16ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "meager", "type": "name"}, {"content": "very small in amount or number", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: My meager rating of 22% said I had more time for things outside of cyberspace and preferred to connect face to face.", "type": "example"}, {"content": "engenn10le16ob02aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cyberspace", "type": "name"}, {"content": " an \u200belectronic \u200bsystem that \u200ballows \u200bcomputer users around the \u200bworld to \u200bcommunicate or \u200baccess \u200binformation ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have  more time for things outside of cyberspace and preferred to connect face to face.", "type": "example"}, {"content": "engenn10le16ob02aud08", "type": "audio"}]}, {"content": "engenn10le16ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Future Continuous Tense", "type": "heading"}, {"content": "You use the Future Continuous tense to talk about something happening at a particular time in the future.  <br/>The action will have started before that time in the future, but it will not be finished at that moment.", "type": "describer"}, {"content": "The <span class=\"strong\">Future Continuous</span> describes an event which will be happening at a future point. ", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">Tonight the Now Gallery will be displaying art documenting \"The Death of Conversation\".</span>", "type": "text"}, {"content": "It can also describe events which are going to happen anyway, rather than events which we choose to make happen.<br/>", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">You don't need to forward this to me, I'll be going there anyway.</span>", "type": "text"}, {"content": " It can also be used to refer to fixed arrangements and plans. ", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">Stationary cameras will be recording people talking, texting, tweeting, posting, or taking selfies. </span>", "type": "text"}, {"content": "I'll be the one standing in a corner watching the rest of you.", "type": "example"}, {"content": "While you're looking at the art - that is if you really are looking at the art - I'll be taking note of how you interact.", "type": "example"}, {"content": "This in turn will be feeding into large viewing screens at either end of the gallery.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Unreal Conditional: Expressing Imaginary Future Situations", "type": "heading"}, {"content": "You use the Unreal Conditional to express imaginary or future situations. <br/>You use the structure <span class=\"italic\">If \u2026 were</span> + <span class=\"italic\">to</span> + <span class=\"italic\">infinitive</span> to express a hypothetical future situation that is unlikely to happen.", "type": "describer"}, {"content": "The Present Unreal Conditional is also called the Second Conditional.<br/>", "type": "text"}, {"content": "You use the structure:<br/>  <span class=\"italic\">If \u2026 </span>Simple Past<span class=\"italic\">, \u2026 would</span> + <span class=\"italic\">verb</span> or <br/><span class=\"italic\">Would + verb \u2026 if \u2026 </span>Simple Past.", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">If you understood the difference between these two pictures, would you be able to explain it to me?</span> <br/>It is unclear whether I know the difference between the two pictures, so the outcome is impossible to predict.", "type": "text"}, {"content": "You use <span class=\"italic\">If \u2026 were</span> + <span class=\"italic\">to</span> + <span class=\"italic\">infinitive</span> to talk about imaginary future situations, especially when it is not likely the situation will happen.", "type": "text"}, {"content": "Example:<br/><span class=\"italic\">If you were to stand in a crowded area and watch the people, what would you see?</span>", "type": "text"}, {"content": "If you were to stand close to people, what would you hear?", "type": "example"}, {"content": "If you were to compare a picture of people on the street today with those taken 25 years ago, what would you notice?", "type": "example"}, {"content": "If you knew how seriously dull people were today, you would understand my point immediately! ", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "As you go through your week, observe people's behavior while using their cellphones, especially when they are in groups.", "type": "text"}, {"content": "Write short notes describing what you see and whether the people are interacting with each other or not.", "type": "text"}, {"content": "Do this 3 or 4 times. ", "type": "text"}, {"content": "Use your notes to talk about the way people interact in groups and the influence of electronic devices among them.", "type": "text"}, {"content": "State what you think will be happening in the future.", "type": "text"}, {"content": "Talk about imaginary future situations.", "type": "text"}, {"content": "Read your descriptions to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write short notes describing people in groups.", "type": "text"}, {"content": "I use notes to describe interaction among people.", "type": "text"}, {"content": "I share my description with a partner.", "type": "text"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": " I can talk about technology and personal dilemmas.", "type": "Learning Outcomes"}, {"content": "I can express events that will be happening at a future point. ", "type": "Learning Outcomes"}, {"content": "I can talk about imaginary future situations. ", "type": "Learning Outcomes"}, {"content": " How do you feel when people use cell phones when they are out with you?", "type": "Free Header Item"}, {"content": " How often do you tune out of a conversation and tune into information on your phone when you are out?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}]}, "type": "feedback"}, {"content": " Ask your partner:", "type": "free_header_text"}, {"content": " My cell phone is my life!", "type": "free_type_text_area"}], "img_path": "", "questions": [], "type": "WLC", "id": 0, "stimuli_ids": [0]}, {"template_override": 1, "type": "STI", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "