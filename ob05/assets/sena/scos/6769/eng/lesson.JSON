{"_data": [{"type": "metadata", "contents": [{"content": "A Brave New World", "type": "lesson_name"}, {"content": "Social Networks", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Understand detailed descriptions of real or imaginary events and experiences in present, past or future and in spoken or written texts.", "type": "primary"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range